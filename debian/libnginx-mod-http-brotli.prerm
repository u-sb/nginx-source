#!/bin/sh
set -e

case "$1" in
  remove|deconfigure)
    TARGET="/usr/share/nginx/conf-available/brotli.conf"
    LINK="/etc/nginx/conf.d/brotli.conf"

    if [ -L "$LINK" ]; then
      CURRENT_TARGET=$(readlink -f "$LINK" || true)
      if [ "$CURRENT_TARGET" = "$TARGET" ]; then
        rm -f "$LINK"
      fi
    fi
    ;;
esac

#DEBHELPER#

exit 0
